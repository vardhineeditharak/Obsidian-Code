/**
 * @see https://www.electron.build/configuration/configuration
 */
{
  "appId": "com.obsidiancode.app",
  "productName": "Obsidian Code",
  "copyright": "Copyright © 2026 Obsidian Code Contributors",
  "directories": {
    "output": "dist/desktop",
    "buildResources": "build"
  },
  "files": [
    "dist/client/**/*",
    "dist-electron/**/*",
    "package.json"
  ],
  "publish": {
    "provider": "github",
    "owner": "vardhineeditharak",
    "repo": "Obsidian-Code",
    "releaseType": "release"
  },
  "protocols": [
    {
      "name": "Obsidian Code Protocol",
      "schemes": [
        "obsidian-code",
        "obsidian"
      ]
    }
  ],
  "fileAssociations": [
    {
      "ext": [
        "ts",
        "tsx",
        "js",
        "jsx",
        "json",
        "py",
        "rs",
        "go",
        "cpp",
        "c",
        "java",
        "html",
        "css",
        "md"
      ],
      "name": "Source Code Document",
      "role": "Editor"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-Setup-${version}-${arch}.${ext}",
    "icon": "build/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowToChangeInstallationDirectory": true,
    "deleteAppDataOnUninstall": false,
    "createDesktopShortcut": "always",
    "createStartMenuShortcut": true,
    "shortcutName": "Obsidian Code",
    "runAfterFinish": true
  },
  "mac": {
    "category": "public.app-category.developer-tools",
    "minimumSystemVersion": "10.15.0",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      },
      {
        "target": "zip",
        "arch": ["x64", "arm64"]
      }
    ],
    "artifactName": "${productName}-${version}-${arch}.${ext}",
    "icon": "build/icon.png",
    "hardenedRuntime": true,
    "gatekeeperAssess": false,
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.plist"
  },
  "dmg": {
    "title": "${productName} ${version}",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 380
    }
  }
}
