# ==============================================================================
# Obsidian Code — Environment Variables Configuration
# ==============================================================================

# Server Environment Mode ('development' | 'production' | 'test')
NODE_ENV=development

# Server Port (default: 5000)
PORT=5000

# MongoDB Database URI (MongoDB Atlas or Local MongoDB)
# Atlas Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/obsidian-code?retryWrites=true&w=majority
# Local Example: mongodb://127.0.0.1:27017/obsidian-code
MONGODB_URI=mongodb://127.0.0.1:27017/obsidian-code

# JWT Secret for signing session tokens (must be at least 32 characters)
JWT_SECRET=obsidian-code-dev-jwt-super-secret-key-32chars!

# Application URLs
APP_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:3000

# WebRTC STUN/TURN Infrastructure (Optional)
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# WEBRTC_TURN_URL=
# WEBRTC_TURN_USERNAME=
# WEBRTC_TURN_CREDENTIAL=

# OAuth Authentication Credentials (Optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
