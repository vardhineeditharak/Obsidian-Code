# ==============================================================================
# Obsidian Code — Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env' in your project root before launching:
#   cp .env.example .env
# ==============================================================================

NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000
APP_URL=http://localhost:5000

# MongoDB connection URI (Atlas or local)
MONGODB_URI=mongodb://127.0.0.1:27017/obsidian-code

# Secret key used for signing and verifying JWT session tokens (min. 32 chars; change in production)
JWT_SECRET=obsidian-code-dev-jwt-super-secret-key-32chars!

# Clerk Authentication (Client & Server)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# Native code execution runs untrusted code on the server. It is disabled in production
# unless explicitly enabled inside an isolated runner/container.
# EXECUTION_ENABLED_IN_PRODUCTION=false

# WebRTC STUN / Optional TURN
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
# WEBRTC_TURN_URL=turn:turn.example.com:3478
# WEBRTC_TURN_USERNAME=your-turn-username
# WEBRTC_TURN_CREDENTIAL=your-turn-password

# Optional GitHub OAuth Application Credentials
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
