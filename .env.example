# ==============================================================================
# Obsidian Code — Environment Variables Configuration
# ==============================================================================
# Copy this file to '.env' in your project root before launching:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Environment & Networking
# ------------------------------------------------------------------------------
# Environment mode ('development' | 'production' | 'test')
NODE_ENV=development

# Backend HTTP & WebSocket Server Port (default: 5000)
# Express REST API, WebSocket Yjs sync server, and /healthz endpoint bind here.
PORT=5000

# Client Web Application Origin (default: http://localhost:3000)
# Configures Express CORS middleware to allow requests from the Vite frontend.
CLIENT_ORIGIN=http://localhost:3000

# Canonical Backend Application URL (default: http://localhost:5000)
# Used for generating absolute links, callbacks, and health endpoints.
APP_URL=http://localhost:5000

# ------------------------------------------------------------------------------
# 2. Database (MongoDB)
# ------------------------------------------------------------------------------
# MongoDB connection URI (MongoDB Atlas or Local MongoDB instance)
# Local Example:
#   MONGODB_URI=mongodb://127.0.0.1:27017/obsidian-code
# MongoDB Atlas Example:
#   MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/obsidian-code?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/obsidian-code

# ------------------------------------------------------------------------------
# 3. Security & Session Authentication
# ------------------------------------------------------------------------------
# Secret key used for signing and verifying JWT session tokens (min. 32 characters)
# IMPORTANT: In production, generate a secure random secret (e.g. `openssl rand -hex 32`)
JWT_SECRET=obsidian-code-dev-jwt-super-secret-key-32chars!

# ------------------------------------------------------------------------------
# 4. Clerk Authentication (Client & Server)
# ------------------------------------------------------------------------------
# Clerk Publishable Key (Required for client-side authentication & user session sync)
# Obtain from your Clerk dashboard: https://dashboard.clerk.com -> API Keys
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Clerk Secret Key (Optional / Backend server-side verification)
# Obtain from your Clerk dashboard: https://dashboard.clerk.com -> API Keys
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# ------------------------------------------------------------------------------
# 5. Real-Time Collaboration & WebRTC Infrastructure (Optional)
# ------------------------------------------------------------------------------
# WebRTC STUN Server URLs (comma-separated or single URL)
# Used by y-webrtc for P2P collaborator discovery and direct peer channels.
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# Optional TURN Relay Servers (for restrictive corporate firewalls or symmetric NATs)
# WEBRTC_TURN_URL=turn:turn.example.com:3478
# WEBRTC_TURN_USERNAME=your-turn-username
# WEBRTC_TURN_CREDENTIAL=your-turn-password

# ------------------------------------------------------------------------------
# 6. OAuth Authentication Credentials (Optional Providers)
# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials
# GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-google-client-secret

# GitHub OAuth Application Credentials
# GITHUB_CLIENT_ID=your-github-client-id
# GITHUB_CLIENT_SECRET=your-github-client-secret
