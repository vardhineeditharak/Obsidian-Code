# ==============================================================================
# Obsidian Code — Environment Variables Template
# ==============================================================================
# Copy this file to '.env' before starting the application:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Backend Secrets (Used by Express API & WebSocket Server)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
CLIENT_ORIGIN=http://localhost:3000

# MongoDB connection string (MongoDB Atlas or local: mongodb://127.0.0.1:27017/obsidian-code)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/obsidian-code?retryWrites=true&w=majority

# Secret key for JWT session tokens (minimum 32 characters)
JWT_SECRET=obsidian-code-dev-jwt-super-secret-key-32chars!

# Clerk Backend Secret Key (from https://dashboard.clerk.com -> API Keys)
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key_here

# ------------------------------------------------------------------------------
# 2. Client & Frontend Variables (Baked into Vite & Desktop App at build time)
# ------------------------------------------------------------------------------
# Clerk Publishable Key (Client public key from Clerk dashboard)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key_here

# Backend REST API endpoint for desktop & client (leave default for local dev)
VITE_API_URL=http://localhost:5000/api

# Real-time WebSocket sync server endpoint (leave default for local dev)
VITE_WS_URL=ws://localhost:5000/ws

# ------------------------------------------------------------------------------
# 3. Collaboration & P2P Mesh (Optional)
# ------------------------------------------------------------------------------
WEBRTC_STUN_URLS=stun:stun.l.google.com:19302
