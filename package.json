{
  "name": "obsidian-code",
  "version": "1.1.2",
  "description": "Production-grade, real-time collaborative code editor combining CRDT multiplayer synchronization with VS Code ergonomics and a Cursor-inspired warm parchment design system.",
  "type": "module",
  "author": "Obsidian Code Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vardhineeditharak/Obsidian-Code.git"
  },
  "bugs": {
    "url": "https://github.com/vardhineeditharak/Obsidian-Code/issues"
  },
  "homepage": "https://github.com/vardhineeditharak/Obsidian-Code#readme",
  "keywords": [
    "collaborative-editor",
    "crdt",
    "yjs",
    "monaco-editor",
    "real-time",
    "webrtc",
    "code-editor",
    "developer-tools",
    "typescript"
  ],
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"tsx server/index.ts\"",
    "dev:client": "vite",
    "dev:server": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "desktop:dev": "cross-env ELECTRON=true concurrently \"vite\" \"tsx server/index.ts\"",
    "desktop:client": "cross-env ELECTRON=true vite",
    "desktop:build": "cross-env ELECTRON=true tsc --noEmit && cross-env ELECTRON=true vite build && electron-builder --publish never",
    "desktop:build:win": "cross-env ELECTRON=true tsc --noEmit && cross-env ELECTRON=true vite build && electron-builder --win --publish never",
    "desktop:build:mac": "cross-env ELECTRON=true tsc --noEmit && cross-env ELECTRON=true vite build && electron-builder --mac --publish never",
    "desktop:pack": "cross-env ELECTRON=true tsc --noEmit && cross-env ELECTRON=true vite build && electron-builder --dir",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "preview": "vite preview",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:clear": "tsx server/scripts/clearDb.ts"
  },
  "dependencies": {
    "@clerk/react": "^6.17.8",
    "@monaco-editor/react": "^4.7.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "electron-updater": "^6.8.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "lucide-react": "^1.54.0",
    "monaco-editor": "^0.57.0",
    "mongoose": "^9.11.1",
    "morphicons": "^1.7.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tsx": "^4.23.15",
    "ws": "^8.22.0",
    "y-indexeddb": "^9.0.12",
    "y-monaco": "^0.1.6",
    "y-webrtc": "^10.3.0",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/jszip": "^3.4.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vitest": "^5.0.3"
  }
}
